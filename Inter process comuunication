
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <ctype.h>
#include <errno.h>

#define FIFO1 "fifo1"
#define FIFO2 "fifo2"
#define FILE_NAME "result.txt"

int main(int argc, char *argv[])
{
    int fd1, fd2;
    char buffer[1024];
    int chars = 0, words = 0, lines = 0;
    int inWord = 0;
    int i;
    char ch, last = '\n';

    if(argc != 2)
    {
        printf("Usage: %s 1 or %s 2\n", argv[0], argv[0]);
        return 1;
    }

    // Create two FIFO pipes
    if(mkfifo(FIFO1, 0666) == -1 && errno != EEXIST)
    {
        perror("mkfifo");
        return 1;
    }

    if(mkfifo(FIFO2, 0666) == -1 && errno != EEXIST)
    {
        perror("mkfifo");
        return 1;
    }

    // PROCESS 1
    if(strcmp(argv[1], "1") == 0)
    {
        printf("PROCESS 1\n");
        printf("Enter sentences (type END to finish):\n");

        fd1 = open(FIFO1, O_WRONLY);

        while(1)
        {
            if(fgets(buffer, sizeof(buffer), stdin) == NULL)
                break;

            if(strcmp(buffer, "END\n") == 0 ||
               strcmp(buffer, "END") == 0)
                break;

            write(fd1, buffer, strlen(buffer));
        }

        close(fd1);

        // Receive result from Process 2
        fd2 = open(FIFO2, O_RDONLY);

        printf("\nResult received from Process 2:\n");

        while((i = read(fd2, buffer, sizeof(buffer))) > 0)
        {
            write(STDOUT_FILENO, buffer, i);
        }

        close(fd2);
    }






    // PROCESS 2
    else if(strcmp(argv[1], "2") == 0)
    {
        printf("PROCESS 2\n");

        fd1 = open(FIFO1, O_RDONLY);

        // Read sentences and count characters,
        // words and lines
        while(read(fd1, &ch, 1) > 0)
        {
            chars++;
            last = ch;

            if(ch == '\n')
                lines++;

            if(isspace((unsigned char)ch))
            {
                inWord = 0;
            }
            else if(inWord == 0)
            {
                words++;
                inWord = 1;
            }
        }

        if(chars > 0 && last != '\n')
            lines++;

        close(fd1);

        // Write result into text file
        FILE *fp = fopen(FILE_NAME, "w");

        if(fp == NULL)
        {
            perror("File error");
            return 1;
        }

        fprintf(fp, "Total Characters: %d\n", chars);
        fprintf(fp, "Total Words: %d\n", words);
        fprintf(fp, "Total Lines: %d\n", lines);

        fclose(fp);

        printf("Data counted and saved in result.txt\n");

        // Send file contents to Process 1
        fd2 = open(FIFO2, O_WRONLY);

        fp = fopen(FILE_NAME, "r");

        if(fp == NULL)
        {
            perror("File error");
            close(fd2);
            return 1;
        }

        while(fgets(buffer, sizeof(buffer), fp) != NULL)
        {
            write(fd2, buffer, strlen(buffer));
        }

        fclose(fp);
        close(fd2);

        printf("Result sent to Process 1.\n");
    }
    else
    {
        printf("Invalid argument! Use 1 or 2.\n");
        return 1;
    }

    return 0;
}
